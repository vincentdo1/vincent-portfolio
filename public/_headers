# Headers for files served straight from the Workers asset layer: everything
# in public/ plus /_next/static. These never reach next.config.ts headers(),
# which only covers responses the Worker renders, so the security headers are
# repeated here. Keep them in step with `securityHeaders` there.
# https://developers.cloudflare.com/workers/static-assets/headers

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Content-hashed build output, so it can be cached for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The résumé changes under a stable filename. Never cache it as immutable, or
# recruiters can see a year-stale version.
/resume.pdf
  Cache-Control: public, max-age=3600, must-revalidate

# Project media reuses stable filenames (replaced in place), so it must not be
# cached as immutable either.
/projects/*
  Cache-Control: public, max-age=86400
